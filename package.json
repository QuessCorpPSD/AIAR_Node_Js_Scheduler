{
  "name": "outlook-attachment-pipeline",
  "version": "1.0.0",
  "description": "Scheduled job: reads Outlook attachments via Microsoft Graph, extracts payment advice with LangChain/OpenAI and submits it to the AR API. Exposes /api/health, /api/cron/* and /api-docs.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --expose-gc --max-old-space-size=1536 src/server.js",
    "dev": "node --expose-gc --max-old-space-size=1536 --watch src/server.js"
  },
  "dependencies": {
    "@langchain/core": "^1.2.3",
    "@langchain/openai": "^1.5.5",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "pdfjs-dist": "^6.1.200",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  }
}
